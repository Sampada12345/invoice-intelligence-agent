APP_ENV=production
SERVICE_NAME=invoice-intelligence-agent

POSTGRES_DB=invoice_agent
POSTGRES_USER=invoice_agent
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://invoice_agent:change-me-in-production@postgres:5432/invoice_agent

AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8080
AGENT_SERVICE_EXTERNAL_PORT=8081
AGENT_SERVICE_HEARTBEAT_SECONDS=30
AGENT_SERVICE_LOG_LEVEL=INFO

NGINX_PORT=8088

OPENAI_API_KEY=
OPENAI_INVOICE_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_REMINDER_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_SECRET=change-me-telegram-secret

GMAIL_FROM_EMAIL=billing@example.com
GMAIL_OAUTH_CLIENT_SECRET_FILE=/app/secrets/google-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=/app/data/google-oauth-token.json
GMAIL_ALLOW_USER_INTERACTION=false
GMAIL_SERVICE_CACHE_ENABLED=true
